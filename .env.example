# Copy to .env.local and fill in real values. Never commit .env.local.

# Google OAuth (NextAuth provider)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Neon Postgres
DATABASE_URL=

# Upstash Redis (rate limiting)
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_URL=
REDIS_URL=

# Public site URL (used for canonical/OG links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactional email)
RESEND_API_KEY=
